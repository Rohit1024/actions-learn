{
  "name": "actions-learn",
  "version": "0.1.0",
  "private": true,
  "description": "Local action labs and Mermaid validation for the GitHub Actions teaching site",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:action": "esbuild examples/typescript-action/src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=examples/typescript-action/dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test examples/javascript-action/greet.test.cjs",
    "check:dist": "node scripts/check-dist.cjs"
  },
  "overrides": {
    "katex": "0.18.10"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "puppeteer": "25.16.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "puppeteer@25.16.0": true
  }
}
